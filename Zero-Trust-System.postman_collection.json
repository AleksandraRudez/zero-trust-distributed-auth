              "raw": "{\n  \"username\": \"user1\",\n  \"password\": \"password123\",\n  \"clientType\": \"USER\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["auth", "login"]
