{
  "id": null,
  "uid": "zero-trust-overview",
  "title": "Zero Trust - Distribuirani sistem",
  "tags": ["zero-trust", "diplomski"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Throughput po servisu (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by(application) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 latencija po servisu",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le, application) (rate(http_server_requests_seconds_bucket[1m])))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Broj zahteva po statusu (401 / 403 / 200)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by(application, status) (rate(http_server_requests_seconds_count{status=~\"200|401|403|404\"}[1m]))",
          "legendFormat": "{{application}} - {{status}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Stopa odbijenih zahteva (401+403) %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_seconds_count{status=~\"401|403\"}[1m])) / sum(rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "% odbijeno"
        }
      ]
    },
    {
      "id": 5,
      "title": "JVM heap memorija po servisu",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by(application) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Da li su servisi gore (up)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}